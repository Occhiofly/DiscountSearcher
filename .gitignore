# Eccezione: i contenuti del sito (menu, team, FAQ, assistenza) vivono in
# web/assets/js/data/ e devono essere nel repository, altrimenti il sito
# pubblicato non trova i file e non funziona.
!web/assets/js/data/
#Lo zip dell'applicazione non sta nel repository: si pubblica come GitHub Release
#(vedi "Creare l'eseguibile"). Committarlo faceva crescere la storia di 23 MB a versione.
web/downloads/*.zip

#Copie del database: contengono dati di persone vere (account, email, ticket).
#Si fanno con `python strumenti/db.py backup` e restano fuori dal repository.
backup/

