# Copia questo file in ".env" (senza .example) e inserisci i tuoi valori veri.
# Il file ".env" NON va mai caricato su git (è già escluso nel .gitignore).

DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxx:LA_TUA_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

GMAIL_ADDRESS=tuoaccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Siti web autorizzati a chiamare l'API dal browser (CORS), separati da virgola.
# Facoltativo: se manca, valgono solo gli indirizzi del sito in locale
# (http://127.0.0.1:5510 e http://localhost:5510). In produzione indica
# l'indirizzo pubblico del sito, es.:
# CORS_ORIGINS=https://sito-di-esempio.com,https://www.sito-di-esempio.com

# Ticket di assistenza: chi riceve i nuovi ticket e può rispondere via email.
# Formato "Nome <indirizzo>", separati da virgola. Il nome compare nel ticket
# come autore della risposta (gli indirizzi non vengono mai mostrati agli utenti).
# Se manca, i ticket si aprono comunque ma lo staff non riceve notifiche e le
# risposte via email non vengono lette.
#
# Può essere lo stesso account di GMAIL_ADDRESS: lo staff accede a quella casella
# e risponde alle notifiche da lì (il server legge le risposte dalla Posta inviata).
# SUPPORT_STAFF=Supporto <tuoaccount@gmail.com>
#
# Oppure indirizzi personali (risposte lette dalla Posta in arrivo), anche insieme:
# SUPPORT_STAFF=Supporto <tuoaccount@gmail.com>, Vittorio <vittorio@example.com>

# Area staff del sito (staff.py): gli account del team che vedono tutti i ticket e
# rispondono dal sito. NUMERO dell'account (colonna id della tabella users) e, dopo i
# due punti, il nome mostrato nelle risposte (facoltativo). Numero e non email: l'email
# si può cambiare dal profilo senza verificarla di nuovo. Per trovarlo, su Supabase:
#   SELECT id, username FROM users WHERE username = 'nome_utente';
# STAFF_ACCOUNTS=12:Marco, 15:Vittorio

# Documentazione interattiva dell'API (/docs, /redoc, /openapi.json): spenta di base.
# Accendila solo in locale, per provare gli endpoint dal browser. Su Render lasciala spenta.
# ENABLE_API_DOCS=1

# Indirizzo del sito, usato nei link delle email dei ticket.
# Facoltativo: se manca vale https://discountsearcher.it
# SITE_URL=https://discountsearcher.it
