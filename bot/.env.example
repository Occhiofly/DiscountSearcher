# Copia questo file in ".env" (senza .example) e metti i valori veri.
# Il file ".env" NON va mai su git: e' gia' escluso, e il gancio pre-commit
# (strumenti/controllo_segreti.py) blocca il commit se un token scappa altrove.

# Token del bot, dal Developer Portal di Discord > la tua applicazione > Bot.
# Se lo pubblichi per sbaglio: rigeneralo subito li', toglierlo dai commit non basta.
DISCORD_TOKEN=IL_TUO_TOKEN

# Identificativo dell'applicazione (Developer Portal > General Information).
DISCORD_APP_ID=IL_TUO_APP_ID

# Identificativo del server, per registrare i comandi solo li' durante le prove:
# compaiono subito, invece di aspettare fino a un'ora come quelli globali.
# In produzione lascialo vuoto per registrarli su tutti i server.
DISCORD_GUILD_ID=IL_TUO_SERVER_ID

# API di Discount Searcher. In locale: http://127.0.0.1:8000
API_URL=https://api.discountsearcher.it

# Sito pubblico, usato quando l'API non risponde.
SITO_URL=https://discountsearcher.it
